+#if LIBCURL_VERSION_NUM >= 0x071300 /* Available since 7.34.0 */
 	REGISTER_LONG_CONSTANT("CURL_SSLVERSION_TLSv1_0", CURL_SSLVERSION_TLSv1_0, CONST_PERSISTENT);
 #endif
-#if LIBCURL_VERSION_NUM >= 0x072200 /* Available since 7.34.0 */
