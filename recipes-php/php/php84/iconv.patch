Date: Fri, 22 Nov 2024 13:42:27 +0100
Subject: [PATCH] php84: New recipe for PHP 8.4.1

Upstream-Status: Inappropriate [cross compile specific]
---
 build/php.m4 | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/build/php.m4 b/build/php.m4
index 1e0b2820..894f8b63 100644
--- a/build/php.m4
+++ b/build/php.m4
@@ -1833,7 +1833,7 @@ AC_DEFUN([PHP_SETUP_ICONV], [
     [Define to 1 if you have the 'libiconv' function.])
 
   dnl Check libc first if no path is provided in --with-iconv.
-  AS_VAR_IF([PHP_ICONV], [yes], [
+  AS_VAR_IF([PHP_ICONV],  [no], [], [
     dnl Reset LIBS temporarily as it may have already been included -liconv in.
     LIBS_save=$LIBS
     LIBS=
