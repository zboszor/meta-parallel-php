Date: Mon, 15 Jan 2024 12:06:09 +0100
Subject: [PATCH] php74: Add recipe for PHP 7.4.33

Upstream-Status: Inappropriate [cross compile specific]
---
 scripts/php-config.in | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/scripts/php-config.in b/scripts/php-config.in
index 87c20089..33d4b5eb 100644
--- a/scripts/php-config.in
+++ b/scripts/php-config.in
@@ -6,7 +6,7 @@ datarootdir="@datarootdir@"
 exec_prefix="@exec_prefix@"
 version="@PHP_VERSION@"
 vernum="@PHP_VERSION_ID@"
-include_dir="@includedir@/php"
+include_dir="@includedir@/php@program_suffix@"
 lib_dir="@orig_libdir@"
 includes="-I$include_dir -I$include_dir/main -I$include_dir/TSRM -I$include_dir/Zend -I$include_dir/ext -I$include_dir/ext/date/lib"
 ldflags="@PHP_LDFLAGS@"
